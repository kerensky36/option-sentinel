[gource]
title=Option Sentinel
seconds-per-day=1
auto-skip-seconds=1
hide=mouse,progress
background-colour=0a0e1a
dir-colour=f59e0b
highlight-users=true
bloom-multiplier=0.4
bloom-intensity=0.4
file-extensions=true
dir-name-depth=2
file-filter=.gitignore|.env
viewport=1920x1080
output-framerate=60
stop-at-end=true
