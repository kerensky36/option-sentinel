# Schwab API credentials
# Register at https://developer.schwab.com — set callback URL to https://127.0.0.1
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_ACCOUNT_ID=your_account_number_here
# Second account for Covered Call Screener. Raw numbers (e.g. 9720-3003) are
# resolved to API hashes automatically. Use GET /admin/accounts to verify.
SCHWAB_CC_ACCOUNT_ID=9720-3003

# Database
# Default: local SQLite. Switch to Postgres with no logic changes:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/option_sentinel
DATABASE_URL=sqlite+aiosqlite:///./option_sentinel.db

# Email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_RECIPIENT=your@gmail.com

# Black-Scholes risk-free rate (US 3-month Treasury — update annually)
RISK_FREE_RATE=0.045

# Token encryption key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your_fernet_key_here
