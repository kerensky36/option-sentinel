# Schwab API credentials
# Register at https://developer.schwab.com
# Set the callback URL in your Schwab app to: https://your-domain/auth/callback
SCHWAB_CLIENT_ID=your_app_key_here
SCHWAB_CLIENT_SECRET=your_app_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1/auth/callback
SCHWAB_AUTH_URL=https://api.schwabapi.com/v1/oauth/authorize
SCHWAB_TOKEN_URL=https://api.schwabapi.com/v1/oauth/token

# Black-Scholes risk-free rate (US 3-month Treasury — update annually)
RISK_FREE_RATE=0.045

# Macro news voting quorum (specs/017) — Gemini on Vertex AI.
# Auth uses Application Default Credentials (Cloud Run service account needs
# roles/aiplatform.user; locally: gcloud auth application-default login).
# scripts/deploy_backend.sh sets these automatically (TRUE / GCP_PROJECT_ID /
# CLOUD_RUN_REGION); uncomment only to override. For local dev, set them here —
# the quorum endpoint returns 503 until the first two are set.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
# QUORUM_MODEL=gemini-2.5-flash

# AI cost guard (specs/022): analyses per day for the whole service (default 50).
# 0 pauses every AI route (kill switch).
# QUORUM_DAILY_CAP=50

# ── Cloud Run deployment (specs/022) ──────────────────────────────────────────
#
# One-time: bash scripts/setup_gcp_security.sh
#   creates the least-privilege runtime account and moves SCHWAB_CLIENT_SECRET,
#   QUORUM_SEAL_KEY and LOG_PEPPER into Secret Manager. Then set:
# GCP_PROJECT_ID=your-gcp-project
# CLOUD_RUN_SERVICE_ACCOUNT=option-sentinel-run@your-gcp-project.iam.gserviceaccount.com
# Optional billing alert from the setup script:
# BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX
# MONTHLY_BUDGET_USD=50
#
# Deploy: bash scripts/deploy.sh
#
# IMPORTANT:
# - max-instances=1 is required — the PKCE state dict and the daily AI cap are in-memory only.
# - The Schwab token lives in the user's browser sessionStorage only.
#   Cloud Run never persists it. No database, no volume mounts required.
