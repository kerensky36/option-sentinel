# Schwab API credentials
# Register at https://developer.schwab.com
# Set callback URL to: https://your-cloud-run-url/auth/callback (or https://127.0.0.1 for local dev)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Main account for the positions dashboard
SCHWAB_ACCOUNT_ID=your_account_number_here

# Second account for Covered Call Screener (raw numbers resolved automatically)
# SCHWAB_CC_ACCOUNT_ID=9720-3003

# Secret for signing the short-lived CSRF state cookie used during OAuth.
# This is NOT a session secret — the Schwab token is NEVER stored server-side.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# On Cloud Run: store in Secret Manager, inject via --set-secrets=OAUTH_STATE_SECRET=...
OAUTH_STATE_SECRET=change-this-to-a-random-secret-before-deploying

# Black-Scholes risk-free rate (US 3-month Treasury — update annually)
RISK_FREE_RATE=0.045

# ── Cloud Run deployment notes ────────────────────────────────────────────────
#
# gcloud run deploy option-sentinel \
#   --image=gcr.io/YOUR_PROJECT/option-sentinel \
#   --region=us-central1 \
#   --platform=managed \
#   --min-instances=0 \
#   --max-instances=1 \
#   --set-secrets=OAUTH_STATE_SECRET=oauth-state-secret:latest \
#   --set-env-vars=SCHWAB_APP_KEY=...,SCHWAB_APP_SECRET=...,SCHWAB_CALLBACK_URL=...,SCHWAB_ACCOUNT_ID=...
#
# IMPORTANT: The Schwab token is stored ONLY in the user's browser sessionStorage.
# Cloud Run never persists the token. No database, no volume mounts required.
